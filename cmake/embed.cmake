# cmake -DOUT=<file.c> -DFILES="name=path|name=path" -P embed.cmake
# Writes each file as `const unsigned char nba_asset_<name>[]` + `const size_t nba_asset_<name>_size`.
set(code "/* generated by cmake/embed.cmake */\n#include <stddef.h>\n")
string(REPLACE "|" ";" FILES "${FILES}")
foreach(pair IN LISTS FILES)
  string(REPLACE "=" ";" kv "${pair}")
  list(GET kv 0 name)
  list(GET kv 1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
  string(APPEND code "const unsigned char nba_asset_${name}[] = {\n${hex}0};\n")
  string(APPEND code "const size_t nba_asset_${name}_size = ${bytes};\n")
endforeach()
file(WRITE "${OUT}" "${code}")
